{
  "expo": {
    "name": "Rakky Ride",
    "slug": "famutimi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/rakky-ride-logo.png",
    "scheme": "famutimi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/brand/rakky-ride-logo.png",
      "bundleIdentifier": "com.famutimi.ride"
    },
    "android": {
      "package": "com.famutimi.ride",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/rakky-ride-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand/rakky-ride-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/rakky-ride-logo.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      "react-native-maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Rakky Ride to use your location to find pickup points and nearby drivers.",
          "locationAlwaysAndWhenInUsePermission": "Allow Rakky Ride to use your location while you are online so riders can see your arrival.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
