# Client values and non-secret native build inputs belong here.
# Backend secrets go in backend/.env or the server secret store.
# Native calling is included by default; it requires a rebuilt binary and backend credentials.
# For cloud builds, set these in the selected EAS environment instead.
# See ../docs/deployment/trip-audio-setup.md for setup.
# iOS distribution builds only: match the signed APNs entitlement.
# Local builds default to development. Android does not need this setting.
# RAKKY_APNS_ENVIRONMENT=production
# Cloudinary uploads are planned through the backend; no Cloudinary values are
# needed here. Never put its API secret in an EXPO_PUBLIC_ variable. See ../plan.md.
# Web/iOS simulator can use localhost. A physical phone must use your Mac's LAN
# address (for example http://192.168.1.20:4000) or a deployed HTTPS API URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Use a Web application OAuth client. Its Authorized JavaScript origins must
# include http://localhost and http://localhost:8081 for local web sign-in.
# Keep this value aligned with backend GOOGLE_CLIENT_ID_WEB.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# App identity is selected by eas.json; local Expo defaults to development/test.
# No APP_VARIANT value is needed here. Preview/production API URLs are set in
# their matching EAS environments. See ../docs/setup/app-variants.md.
