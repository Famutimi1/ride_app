{
  "name": "famutimi",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~57.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "axios": "^1.20.0",
    "expo": "~57.0.30",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.23",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-callkeep": "4.6.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-incall-manager": "4.3.0",
    "react-native-maps": "^1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "155.0.1",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node --experimental-strip-types scripts/normalize-native-fingerprint.ts",
    "eas-build-post-install": "node --experimental-strip-types scripts/check-build-config.ts",
    "check:build": "node --experimental-strip-types scripts/check-build-config.ts",
    "test:variants": "node --experimental-strip-types --test scripts/test-app-variants.ts",
    "build:test:android": "eas build --platform android --profile preview",
    "build:production:android": "eas build --platform android --profile production",
    "update:test:android": "APP_VARIANT=preview eas update --platform android --channel preview --environment preview",
    "update:production:android": "APP_VARIANT=production eas update --platform android --channel production --environment production",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:feedback": "node --experimental-strip-types --test scripts/test-feedback.ts",
    "test:native-calls-ui": "node --experimental-strip-types scripts/test-native-call-ui.ts"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      }
    }
  }
}
