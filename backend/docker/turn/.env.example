# Copy to .env on the Linux TURN host. No secret values belong in this file.
# Full setup: ../../../docs/deployment/trip-audio-setup.md (relative to this file).
TURN_CONFIG_FILE=/etc/rakky-turn/turnserver.conf
TURN_TLS_CERT_FILE=/etc/rakky-turn/fullchain.pem
TURN_TLS_KEY_FILE=/etc/rakky-turn/privkey.pem
# These must match configuration/certificate ownership on the host.
TURN_UID=1000
TURN_GID=1000
