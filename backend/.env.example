PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/rideapp
REDIS_URL=redis://localhost:6379
# Optional. Required only when Expo Push Service access-token security is enabled.
EXPO_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Cloudinary (SERVER ONLY) — profile photos and authenticated driver documents.
# Setup and rollout: ../docs/features/cloudinary.md
# Copy these into backend/.env locally or Coolify backend RUNTIME variables.
# Get cloud name, API key and API secret from the Cloudinary Console/API Keys.
# Enable after credentials, migration and staging checks are complete.
# Never prefix these secrets with EXPO_PUBLIC_ or put them in mobile/.env.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Asset namespace; use a different prefix/credentials for production.
CLOUDINARY_ASSET_PREFIX=rakky-ride/development
# Upload deadline in milliseconds.
CLOUDINARY_UPLOAD_TIMEOUT_MS=30000
# Lifetime for private document URLs fetched by the backend only.
CLOUDINARY_PRIVATE_DOWNLOAD_TTL_SECONDS=60

FARE_BASE_NGN=800
FARE_PER_KM_NGN=250
FARE_PER_MINUTE_NGN=35

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

TERMII_API_KEY=
TERMII_SENDER_ID=RakkyRide

# Internal testing only; works in production mode, including staff/admin login.
# Set true and set TEST_OTP_CODE=666666 on the private test deployment.
# Skips SMS for registration/login and logs the alternative random OTP.
# Disable and configure Termii before public launch. Other OTP purposes are unaffected.
TEST_OTP_ENABLED=false
TEST_OTP_CODE=

GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=

OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
GOOGLE_MAPS_SERVER_KEY=

DISPATCH_RADIUS_STEPS_M=3000,5000,8000
OFFER_TIMEOUT_SECONDS=15
SEARCH_TIMEOUT_SECONDS=120
MAX_OFFERS_PER_TRIP=6

DRIVER_LOCATION_EMIT_MS=4000
BREADCRUMB_SAMPLE_SECONDS=15
ETA_REFRESH_SECONDS=45
CASH_DEBT_LIMIT_KOBO=500000
TRIP_ESTIMATE_RATE_LIMIT_PER_MIN=20
# Accepted booking-price lifetime, in seconds. Restart backend instances after changes.
TRIP_QUOTE_TTL_SECONDS=900
# Use one prefix across instances. Separate prefixes isolate test/staging queues.
TRIP_QUEUE_PREFIX=bull

# Payments (server only). Use Paystack test keys during development.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_CALLBACK_URL=
PAYMENT_SYNTHETIC_EMAIL_DOMAIN=
ALERT_WEBHOOK_URL=

# Staff money mutations require explicit rollout approval in both backend and dashboard.
ENABLE_ADMIN_MONEY_ACTIONS=false
# Independent mobile/provider mutation gate. Verification of existing payments continues.
ENABLE_LIVE_PAYMENTS=false
AUTH_RATE_LIMIT_PER_MINUTE=300
# Exact trusted proxy IP/CIDR list only. Empty means forwarded IP headers are not trusted.
TRUSTED_PROXY_CIDRS=

# Transactional email (server only).
# Fill these values in backend/.env when ready. Leave EMAIL_ENABLED=false until
# the sender domain, recipients, public links and Resend webhook are configured.
# After setup, control individual email types in dashboard System > Email >
# Email preferences. Saved switches cannot override EMAIL_ENABLED=false.
EMAIL_ENABLED=false
# Resend sending API key. Keep the actual secret in backend/.env only.
RESEND_API_KEY=
# Signing secret from the Resend webhook configured to POST to:
# https://YOUR_BACKEND_HOST/webhooks/resend
# Subscribe to email.sent, email.delivered, email.delivery_delayed, email.failed,
# email.bounced, email.complained and email.suppressed.
RESEND_WEBHOOK_SECRET=
# Verified sending address, optionally formatted as Rakky Ride <address@domain>.
EMAIL_FROM=
# Monitored support mailbox for replies and the email's Contact support link.
EMAIL_REPLY_TO=
# Admin notification mailboxes, comma separated (maximum 20).
# Explicit recipients only; never inferred from all staff accounts.
EMAIL_ADMIN_RECIPIENTS=
# Public HTTPS dashboard origin, without /admin (no trailing path required).
# Also hosts /open-app for customer buttons that launch the installed mobile app.
# No separate EMAIL_APP_URL or mobile web deployment is needed.
EMAIL_DASHBOARD_URL=
# Optional public HTTPS URL of the canonical Rakky Ride logo PNG.
# Leave empty to use EMAIL_DASHBOARD_URL + /brand/rakky-ride-logo.png.
EMAIL_LOGO_URL=
# Setup and launch instructions: ../docs/features/email-system.md

# Browser push, generated once using web-push.generateVAPIDKeys(). Keep the private key secret.
# Preserve the same pair across releases; changing it requires users to re-enable push.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Monitored contact, e.g. mailto:your-support-address or your public HTTPS support URL.
WEB_PUSH_SUBJECT=
