{
  "name": "ride-app-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + TypeScript backend for the ride app",
  "main": "dist/index.js",
  "scripts": {
    "sync:email-brand": "tsx scripts/sync-email-brand.ts",
    "preview:emails": "tsx scripts/preview-emails.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --ignoreConfig --noEmit --target ES2022 --module nodenext --moduleResolution nodenext --esModuleInterop --skipLibCheck --resolveJsonModule scripts/test-isolated.ts scripts/paystack-e2e.ts scripts/paystack-recovery-check.ts scripts/test-service-connections.ts scripts/sync-email-brand.ts scripts/preview-emails.ts scripts/docker-smoke.ts scripts/cloudinary-smoke.ts scripts/cloudinary-inventory.ts",
    "verify": "npm run typecheck && npm run typecheck:scripts && npm test",
    "test": "tsx scripts/test-isolated.ts",
    "test:docker": "tsx scripts/docker-smoke.ts",
    "migrate": "tsx src/shared/config/migrate.ts",
    "migrate:deploy": "node dist/shared/config/migrate.js",
    "test:connections": "tsx scripts/test-service-connections.ts",
    "test:cloudinary": "tsx scripts/cloudinary-smoke.ts --synthetic-upload",
    "cloudinary:inventory": "tsx scripts/cloudinary-inventory.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "ride-app",
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.11",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
