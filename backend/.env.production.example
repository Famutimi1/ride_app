# Copy values into Coolify's RUNTIME environment variables, not Docker build args.
# This file intentionally contains no working credentials. Do not commit a filled copy.
NODE_ENV=production
PORT=4000
# Internal PostgreSQL/Redis URLs supplied by Coolify. localhost is this container.
DATABASE_URL=
# Docker startup applies pending migrations before starting the API.
RUN_MIGRATIONS_ON_START=true
# Optional separate schema-owner credential; DATABASE_URL stays the runtime role.
# Leave empty to run migrations with DATABASE_URL (requires schema permissions).
MIGRATION_DATABASE_URL=
REDIS_URL=
# Generate a unique secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
# Exact proxy addresses/subnets from the actual deployment network; never 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
AUTH_RATE_LIMIT_PER_MINUTE=300

# Backend Google Maps key and the same Google web client ID used by the mobile app.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# Configure before testing real phone-number sign-in. Production does not print OTPs.
TERMII_API_KEY=
TERMII_SENDER_ID=RakkyRide
# Required only if Expo Push Service access-token security is enabled.
EXPO_ACCESS_TOKEN=

# Keep money mutations disabled until the separate payment rollout is approved.
ENABLE_ADMIN_MONEY_ACTIONS=false
ENABLE_LIVE_PAYMENTS=false
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=
PAYMENT_CALLBACK_URL=
PAYMENT_SYNTHETIC_EMAIL_DOMAIN=
ALERT_WEBHOOK_URL=

# BullMQ must use a durable Redis instance with maxmemory-policy=noeviction.
TRIP_QUEUE_PREFIX=bull

# Optional transactional email. Configure the provider and public links before enabling.
EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_ADMIN_RECIPIENTS=
EMAIL_DASHBOARD_URL=
EMAIL_LOGO_URL=

# Other tuning variables and defaults are documented in .env.example.
